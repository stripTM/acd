# Configuración de ACD dentro de Docker. Se monta como /var/www/html/.env
# Las rutas relativas parten de public/ (DocumentRoot); aquí se usan absolutas.

ACD_DIR_TEMPLATES=../app/View/
ACD_DATA_PATH=/var/www/html/data/structures.json
ACD_DATA_DIR_PATH=/var/www/html/data/structures
ACD_DATA_CONTENT_PATH=/var/www/html/data/contents
ACD_DATA_CONTENT_BINARY_ORIGIN_FORM_UPLOAD=FORM_UPLOAD
ACD_DATA_CONTENT_BINARY_ORIGIN_FORM_PATH=PATH
ACD_STORAGE_TYPE_TEXTPLAIN="text/plain"
ACD_STORAGE_TYPE.TEXTPLAIN.NAME="text/plain"
ACD_STORAGE_TYPE.TEXTPLAIN.DISABLED=true
ACD_STORAGE_TYPE_MONGODB=mongodb
ACD_STORAGE_TYPE.MONGODB.NAME="Mongo DB"
ACD_STORAGE_TYPE.MONGODB.DISABLED=false
ACD_STORAGE_TYPE_MYSQL=mysql
ACD_STORAGE_TYPE.MYSQL.NAME="MySql"
ACD_STORAGE_TYPE.MYSQL.DISABLED=true
ACD_STORAGE_TYPE_MONGODB_LEGACY="mongodb-legacy"
ACD_STORAGE_TYPE.MONGODB_LEGACY.NAME="Mongo DB Legacy"
ACD_STORAGE_TYPE.MONGODB_LEGACY.DISABLED=true
ACD_DEFAULT_STORAGE=mongodb

ACD_USE_AUTHENTICATION=true
ACD_AUTH_PERSITENT_EXPIRATION_TIME=31536000
ACD_PATH_AUTH_CREDENTIALS_FILE=/var/www/html/data/auth.json
ACD_PATH_AUTH_PERMANENT_LOGIN_DIR=/var/www/html/data/auth_permanent_login

ACD_ROL_DEVELOPER=developer
ACD_ROL_EDITOR=editor

ACD_MYSQL_SERVER=localhost
ACD_MYSQL_USER=usuarioweb
ACD_MYSQL_PASSWORD=
ACD_MYSQL_SCHEMA=acd

ACD_MONGODB_SERVER="mongodb://mongo:27017"
ACD_MONGODB_DB=acd

ACD_SESSION_GC_MAXLIFETIME=14400
ACD_COOKIE_PREFIX=acd_
